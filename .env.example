# "foundry" calls the Microsoft Foundry agents; "mock" uses offline template text.
EAGLEEYE_MODE=foundry

# Copy this from the Foundry portal: project overview -> endpoint.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Agent names exactly as created in the Foundry portal.
# Leave an agent empty until it exists; the pipeline stops after the last configured agent.
AGENT_FIELD_MAPPER=FieldMapper
AGENT_TACTICAL_CONTEXT=TacticalContextAgent
AGENT_DECISION=DecisionAgent
# Explains decisions (Analyse) and debriefs Player's Eye drills (Train). Offline template if empty.
AGENT_COACH=CoachAgent

# File Search vector store of TacticalContextAgent; leave empty to discover it from the agent.
# The knowledge files change only through KnowledgeScout research that the admin approves.
KNOWLEDGE_VECTOR_STORE_ID=

# KnowledgeScout: background web research that grows knowledge/football_reference.md
# (never runs inside an analysis click). Agent name as created in Foundry, with the Web Search tool.
# Empty = offline samples only (no web search, no cost).
AGENT_KNOWLEDGE_SCOUT=
# review = save proposals in knowledge/proposals/ for approval (recommended); auto = apply after the code checks.
SCOUT_MODE=review
# Run one research round every N hours while the app runs. 0 = off (run it on demand instead).
SCOUT_INTERVAL_HOURS=0

# ---- Security (see backend/security.py) ----
# Admin token for scout run/approve/reject, knowledge sync and the "unclear explanations" queue.
# Empty = admin actions only from this machine (localhost). ALWAYS set a long random value when deployed.
ADMIN_TOKEN=
# production hides the API docs; development is fine locally.
EAGLEEYE_ENV=development
# Per-visitor rate limits on the public endpoints (on/off).
RATE_LIMITS=on
# Global budget of Foundry agent calls per hour; above it, answers use the offline text.
AGENT_CALLS_PER_HOUR=600
# on = at startup, ask the agents about the key moment in the background (about 9 clicks), so the first
# visitors get instant answers. Answers are saved in data/cache/ and reused after a restart.
WARMUP=on
# 1 = show raw error details to everyone (never in production). Admin requests always see them.
EAGLEEYE_DEBUG=0
